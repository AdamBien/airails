#!/usr/bin/env -S java --source 25

/// Builds one zip per supported AI agent into `target/`, with the agent's
/// home-relative skill directory baked into the entry paths, so installation
/// is a single command without a JDK or git:
///
/// ```
/// unzip airails-claude.zip -d ~
/// ```
///
/// Additionally builds agent-neutral zips whose entries live under a plain
/// `skills/` prefix, for agents not listed in `targets()` or for manual
/// installs into a custom location: `airails-skills.zip` with every skill,
/// and one `airails-<bundle>.zip` per entry of `bundles()`: the skills a
/// single stack composes from, plus the `sbce` and `documentation` add-ons. Bundles are deliberately not multiplied by
/// agent — they unzip into the agent's configuration directory, the parent of
/// its skills directory, instead of `$HOME`; the `airails` wizard strips the
/// prefix and targets the skills directory itself:
///
/// ```
/// unzip airails-web.zip -d ~/.claude
/// ```
///
/// Run from the repository root — locally or from the release-skills GitHub
/// Actions workflow, which publishes `target/*.zip` as release assets. The
/// `targets()` map and the noise filter mirror `installSkills`, which stays
/// the managed, interactive install path — when an agent is added there, add
/// it here too.
String name = MethodHandles.lookup().lookupClass().getName();
String version = "2026-11-10.1";

/// Agent name (zip suffix) and its home-relative skills directory (entry prefix).
record Target(String agent, String prefix) {}

/// Bundle name (zip suffix) and the skills it ships, by directory name.
record Bundle(String name, List<String> skills) {}

List<Target> targets() {
    return List.of(
            new Target("claude", ".claude/skills"),
            new Target("vibe", ".vibe/skills"),
            new Target("kiro", ".kiro/skills"),
            new Target("copilot", ".copilot/skills"),
            new Target("codex", ".agents/skills"),
            new Target("goose", ".config/goose/skills")
    );
}

/// What every stack composes with, spec-driven or not: the architecture,
/// its review, the definition of done, and the README conventions.
List<String> core() {
    return List.of("bce", "bce-reviewer", "system-tests", "readme");
}

/// One bundle per stack, each a vertical slice through the skill layers:
/// `core()` plus the stack skill, its building blocks, conventions, and test
/// loop. `sbce` and `documentation` are add-ons for any stack bundle and do
/// not repeat the core. `fullstack` is the one horizontal cut: the spec-driven
/// workflow from system brief to EARS tests, a MicroProfile backend, and a
/// web-components frontend in a single install, so a system with both tiers
/// needs no second bundle. Overlap between bundles is intended — unzipping two
/// bundles writes identical files twice. A skill in no bundle still ships in
/// the per-agent and `airails-skills.zip` archives; the build lists such skills.
List<Bundle> bundles() {
    return List.of(
            new Bundle("sbce", List.of("sbce", "ears-tests", "capability-brief", "system-brief")),
            new Bundle("documentation", List.of("readme", "bce-diagrams", "mermaid", "drawio")),
            new Bundle("java-server", with(
                    "microprofile-server", "continuous-testing", "aws-cdk",
                    "java-conventions", "concerns", "jdbc-persistence", "memory-persistence", "zjson")),
            new Bundle("java-cli", with(
                    "java-cli-app", "java-cli-script", "java-conventions", "concerns",
                    "zb", "zb-release-pipeline", "zargs", "zcfg", "zcl", "zjson", "zunit",
                    "zhtmldb", "zllm-scripts", "jdbc-persistence", "memory-persistence")),
            new Bundle("web", with(
                    "web-conventions", "javascript-conventions",
                    "web-static", "web-sprinkles", "web-components",
                    "web-system-tests", "web-latest", "web-pwa",
                    "web-performance-reviewer", "web-standards-reviewer")),
            new Bundle("migrations", with(
                    "migration-advisor", "concept-extractor", "concept-clarifier",
                    "bc-carver", "concept-annotator", "characterization-tests", "simplifier",
                    "java-conventions", "concerns", "java-distiller", "python-to-java")),
            new Bundle("fullstack", with(
                    "system-brief", "capability-brief", "sbce", "ears-tests",
                    "microprofile-server", "continuous-testing",
                    "java-conventions", "concerns", "jdbc-persistence", "memory-persistence",
                    "web-components", "web-conventions", "javascript-conventions",
                    "web-system-tests", "web-standards-reviewer", "web-latest"))
    );
}

List<String> with(String... skills) {
    return Stream.concat(core().stream(), Stream.of(skills)).toList();
}

void main() throws Exception {
    IO.println(name + " " + version);
    var source = Path.of("").toAbsolutePath();
    var skills = findSkillDirs(source);
    var skillNames = skills.stream().map(this::skillName).collect(Collectors.joining(", "));
    IO.println("%s: %d skill(s) in %s: %s".formatted(name, skills.size(), source, skillNames));
    var output = Files.createDirectories(Path.of("target"));
    for (var target : targets()) {
        var zip = archive(target.agent(), target.prefix(), skills, output);
        IO.println("  %s <- %s".formatted(zip, target.prefix()));
    }
    var generic = archive("skills", "skills", skills, output);
    IO.println("  %s <- %s".formatted(generic, "skills"));
    var bundled = new TreeSet<String>();
    for (var bundle : bundles()) {
        var selected = select(bundle, skills);
        var zip = archive(bundle.name(), "skills", selected, output);
        IO.println("  %s <- %d skill(s)".formatted(zip, selected.size()));
        bundled.addAll(bundle.skills());
    }
    var unbundled = skills.stream().map(this::skillName).filter(s -> !bundled.contains(s)).toList();
    if (!unbundled.isEmpty()) {
        IO.println("%s: in no bundle (per-agent and skills zips only): %s".formatted(name, String.join(", ", unbundled)));
    }
    IO.println(name + ": done");
}

/// The skill directories a bundle names, in manifest order. A name that
/// matches no skill (typo, renamed or removed skill) fails the build rather
/// than silently publishing a thinner bundle; so does a bundle name that
/// would overwrite an agent or the generic zip.
List<Path> select(Bundle bundle, List<Path> skills) {
    var reserved = Stream.concat(targets().stream().map(Target::agent), Stream.of("skills")).toList();
    if (reserved.contains(bundle.name())) {
        System.err.println("%s: bundle name '%s' collides with an agent zip".formatted(name, bundle.name()));
        System.exit(1);
    }
    var byName = skills.stream().collect(Collectors.toMap(this::skillName, Function.identity()));
    var missing = bundle.skills().stream().filter(s -> !byName.containsKey(s)).toList();
    if (!missing.isEmpty()) {
        System.err.println("%s: bundle '%s' names unknown skill(s): %s".formatted(name, bundle.name(), String.join(", ", missing)));
        System.exit(1);
    }
    return bundle.skills().stream().distinct().map(byName::get).toList();
}

/// One zip whose entries all live under `prefix/<skill>/`, so extracting into
/// `$HOME` lands the skills exactly where the agent discovers them. Entries
/// are sorted for reproducible archives. Written through the zip filesystem
/// provider with POSIX attributes enabled, so unix permissions (notably the
/// exec bit of bundled `scripts/`) survive `unzip`.
Path archive(String suffix, String prefix, List<Path> skills, Path output) throws IOException {
    var zipFile = output.resolve("airails-" + suffix + ".zip");
    // `create=true` opens an existing archive instead of replacing it.
    Files.deleteIfExists(zipFile);
    var env = Map.of("create", "true", "enablePosixFileAttributes", "true");
    try (var zip = FileSystems.newFileSystem(URI.create("jar:" + zipFile.toUri()), env)) {
        for (var skill : skills) {
            try (var paths = Files.walk(skill)) {
                for (var file : (Iterable<Path>) paths.filter(Files::isRegularFile).sorted()::iterator) {
                    var relative = skill.relativize(file);
                    if (isNoise(relative)) {
                        continue;
                    }
                    var entry = zip.getPath(prefix, skillName(skill), entryName(relative));
                    Files.createDirectories(entry.getParent());
                    Files.copy(file, entry);
                    Files.setPosixFilePermissions(entry, Files.getPosixFilePermissions(file));
                }
            }
        }
    }
    return zipFile;
}

/// Zip entries use `/` regardless of the platform separator.
String entryName(Path relative) {
    return relative.toString().replace(File.separatorChar, '/');
}

/// Skill directories under `root` — the parent of every `SKILL.md`, skipping
/// dot-directories below `root` (mirrors `installSkills`).
List<Path> findSkillDirs(Path root) throws IOException {
    try (var paths = Files.walk(root)) {
        return paths
                .filter(this::isSkillFile)
                .map(Path::getParent)
                .filter(dir -> isVisible(root, dir))
                .sorted()
                .toList();
    }
}

boolean isNoise(Path relative) {
    for (var segment : relative) {
        var part = segment.toString();
        if (part.startsWith(".") || part.equals("README.md")) {
            return true;
        }
    }
    return false;
}

boolean isVisible(Path root, Path path) {
    return !root.relativize(path).toString().contains(File.separator + ".");
}

boolean isSkillFile(Path path) {
    return path.getFileName().toString().equals("SKILL.md");
}

String skillName(Path skillDir) {
    return skillDir.getFileName().toString();
}
