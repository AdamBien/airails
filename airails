#!/usr/bin/env -S java --source 25

import module java.base;
import module java.net.http;

/// Installs released airails.dev skill bundles in one shot — select, download,
/// extract — globally or into a project. Released bundles only: the
/// `airails-<bundle>.zip` assets of the rolling `skills` release that `zipSkills`
/// builds in CI. The release is the manifest, so a bundle added there needs no
/// change here. Working-tree installs from a clone are `installSkills`' job.
///
/// ```
/// curl -fsSL https://raw.githubusercontent.com/AdamBien/airails/main/airails | java --source 25 /dev/stdin
/// curl -fsSL https://raw.githubusercontent.com/AdamBien/airails/main/airails | java --source 25 /dev/stdin -project . -agents claude -bundles web,sbce -yes
/// ```
interface Boundary {

    String NAME = scriptName();
    String VERSION = "2026-11-06.2";

    /// Piped from `curl`, the class is named after `/dev/stdin`, not the script.
    static String scriptName() {
        var derived = MethodHandles.lookup().lookupClass().getEnclosingClass().getName();
        return derived.equals("stdin") ? "airails" : derived;
    }

    static void installBundles(List<String> arguments) throws Exception {
        IO.println(NAME + " " + VERSION);
        var invocation = parse(arguments);
        var released = released();
        if (invocation.list()) {
            IO.println(listing(released));
            return;
        }
        var terminal = Terminal.open();
        var scope = scope(invocation, terminal);
        var agents = agents(invocation, terminal);
        var bundles = bundles(invocation, released, terminal);
        var work = Files.createTempDirectory(NAME + "-");
        try {
            IO.println("%s: fetching %s from the skills release".formatted(NAME, String.join(", ", bundles)));
            var downloaded = download(bundles, work);
            var directories = scope.directories(agents);
            IO.println(plan(scope, downloaded, directories));
            if (!invocation.yes() && !terminal.confirm("Proceed? (y/n)")) {
                IO.println(NAME + ": aborted, nothing installed");
                return;
            }
            for (var directory : directories.keySet()) {
                var installed = Control.installInto(downloaded, directory);
                IO.println("%s: %d skill(s) -> %s".formatted(NAME, installed, directory));
            }
            if (scope instanceof Entity.Project) {
                IO.println(NAME + ": commit the skills directories to share them with the project");
            }
            IO.println(NAME + ": done");
        } finally {
            Control.deleteRecursively(work);
        }
    }

    static Entity.Invocation parse(List<String> arguments) {
        var tokens = arguments.stream().flatMap(Boundary::splitColonValue).toList();
        var list = false;
        var global = false;
        var yes = false;
        Path project = null;
        var agents = List.<String>of();
        var bundles = List.<String>of();
        for (var i = 0; i < tokens.size(); i++) {
            var token = tokens.get(i);
            switch (Entity.Arg.from(token)) {
                case HELP -> {
                    IO.println(usage());
                    System.exit(0);
                }
                case VERSION -> System.exit(0);
                case LIST -> list = true;
                case GLOBAL -> global = true;
                case YES -> yes = true;
                case PROJECT -> project = projectRoot(valueAt(tokens, ++i, token));
                case AGENTS -> agents = csv(valueAt(tokens, ++i, token));
                case BUNDLES -> bundles = csv(valueAt(tokens, ++i, token));
                case null -> Log.stop("unknown argument %s — try -help".formatted(token));
            }
        }
        if (global && project != null) {
            Log.stop("-global and -project exclude each other");
        }
        return new Entity.Invocation(list, global, project, agents, bundles, yes);
    }

    /// zargs colon style (`-project:.`) becomes two tokens, so both styles parse alike.
    static Stream<String> splitColonValue(String argument) {
        var colon = argument.indexOf(':');
        if (colon < 0 || Entity.Arg.from(argument) == null) {
            return Stream.of(argument);
        }
        return Stream.of(argument.substring(0, colon), argument.substring(colon + 1));
    }

    static String valueAt(List<String> tokens, int index, String option) {
        if (index >= tokens.size()) {
            Log.stop("missing value for " + option);
        }
        return tokens.get(index);
    }

    static Path projectRoot(String argument) {
        var root = Path.of(argument).toAbsolutePath().normalize();
        if (!Files.isDirectory(root)) {
            Log.stop("project root %s is not a directory".formatted(root));
        }
        return root;
    }

    static List<String> csv(String value) {
        return Stream.of(value.split("[,\\s]+")).filter(Predicate.not(String::isEmpty)).toList();
    }

    static List<String> released() {
        try {
            return Control.releasedBundles();
        } catch (IOException | InterruptedException e) {
            Log.warn("release listing unavailable (%s), using built-in bundle names".formatted(e.getMessage()));
            return Entity.FALLBACK_BUNDLES;
        }
    }

    static Entity.Scope scope(Entity.Invocation invocation, Terminal terminal) throws IOException {
        if (invocation.project() != null) {
            return new Entity.Project(invocation.project());
        }
        if (invocation.global()) {
            return new Entity.Global(Control.HOME);
        }
        var answer = terminal.ask("Install globally into %s, or into a project? (g/p)".formatted(Control.HOME), "g");
        if (answer.toLowerCase().startsWith("p")) {
            var root = terminal.ask("Project root", Path.of("").toAbsolutePath().toString());
            return new Entity.Project(projectRoot(root));
        }
        return new Entity.Global(Control.HOME);
    }

    static List<Entity.Agent> agents(Entity.Invocation invocation, Terminal terminal) throws IOException {
        var detected = Control.detectedAgents();
        var ids = invocation.agents().isEmpty()
                ? terminal.choose("Agents", Entity.Agent.IDS, id -> detected.contains(id) ? "detected" : "", detected)
                : resolve("agent", invocation.agents(), Entity.Agent.IDS);
        return ids.stream().map(Entity.Agent::of).toList();
    }

    static List<String> bundles(Entity.Invocation invocation, List<String> released, Terminal terminal) throws IOException {
        return invocation.bundles().isEmpty()
                ? terminal.choose("Bundles", released, Entity::hint, List.of("skills"))
                : resolve("bundle", invocation.bundles(), released);
    }

    /// Exits on the first unknown name, so a typo never installs half a selection.
    static List<String> resolve(String what, List<String> requested, List<String> options) {
        if (requested.contains("all")) {
            return options;
        }
        var unknown = requested.stream().filter(Predicate.not(options::contains)).toList();
        if (!unknown.isEmpty()) {
            Log.stop("unknown %s(s) %s — choose from: %s".formatted(what, unknown, String.join(", ", options)));
        }
        return requested.stream().distinct().toList();
    }

    static List<Entity.Bundle> download(List<String> bundles, Path work) throws InterruptedException {
        try {
            return Control.download(bundles, work);
        } catch (IOException e) {
            Log.stop(e.getMessage());
            return List.of();
        }
    }

    static String usage() {
        return """
               Usage: %1$s [options]
                 interactive wizard; each option answers one question
               %2$s
               non-interactive: %1$s -project . -agents claude -bundles web,sbce -yes
               released bundles only; install from a clone with ./installSkills""".formatted(NAME, Entity.Arg.usage());
    }

    static String listing(List<String> released) {
        return released.stream()
                .map(bundle -> "  %-14s %s".formatted(bundle, Entity.hint(bundle)))
                .collect(Collectors.joining("\n"));
    }

    static String plan(Entity.Scope scope, List<Entity.Bundle> bundles, Map<Path, List<String>> directories) {
        var contents = bundles.stream().map(Entity.Bundle::describe).collect(Collectors.joining("\n"));
        var names = bundles.stream().map(Entity.Bundle::name).collect(Collectors.joining(" + "));
        var targets = directories.entrySet().stream()
                .map(entry -> "  %s (%s)".formatted(entry.getKey(), String.join(", ", entry.getValue())))
                .collect(Collectors.joining("\n"));
        return """
               %s
               %s: %s scope, installing %s into
               %s""".formatted(contents, NAME, scope.label(), names, targets);
    }

    /// Questions go to the controlling terminal, not stdin: piped from `curl`,
    /// stdin carries the script itself. Without a terminal every answer must
    /// arrive as an option.
    record Terminal(BufferedReader reader) {

        static Terminal open() {
            try {
                return new Terminal(Files.newBufferedReader(Path.of("/dev/tty")));
            } catch (IOException _) {
                return new Terminal(null);
            }
        }

        String ask(String prompt, String fallback) throws IOException {
            if (reader == null) {
                Log.stop("no terminal for questions — answer them with options: -global|-project <root>, -agents <ids>, -bundles <names>, -yes; see -help");
            }
            IO.print("%s [%s]: ".formatted(prompt, fallback));
            var line = reader.readLine();
            if (line == null) {
                Log.stop("input closed");
            }
            return line.isBlank() ? fallback : line.strip();
        }

        boolean confirm(String prompt) throws IOException {
            return ask(prompt, "y").toLowerCase().startsWith("y");
        }

        /// Numbers or names, comma or space separated, `all` for everything;
        /// empty keeps the default. Re-asks on an unknown token.
        List<String> choose(String what, List<String> options, Function<String, String> hint, List<String> defaults) throws IOException {
            IO.println(menu(what, options, hint));
            while (true) {
                var tokens = csv(ask("%s (numbers or names, all)".formatted(what), String.join(",", defaults)));
                if (tokens.contains("all")) {
                    return options;
                }
                var unknown = tokens.stream().filter(token -> Entity.pick(options, token).isEmpty()).toList();
                if (!unknown.isEmpty()) {
                    IO.println("  unknown: " + String.join(", ", unknown));
                    continue;
                }
                var chosen = tokens.stream().map(token -> Entity.pick(options, token).orElseThrow()).distinct().toList();
                if (!chosen.isEmpty()) {
                    return chosen;
                }
            }
        }

        static String menu(String what, List<String> options, Function<String, String> hint) {
            var lines = IntStream.range(0, options.size())
                    .mapToObj(i -> "  %d) %-14s %s".formatted(i + 1, options.get(i), hint.apply(options.get(i))))
                    .collect(Collectors.joining("\n"));
            return """
                   %s:
                   %s""".formatted(what, lines);
        }
    }

    enum Log {

        WARN("\033[38;5;214m"),
        ERROR("\033[38;5;196m");

        static final String RESET = "\033[0m";

        String color;

        Log(String color) {
            this.color = color;
        }

        void out(String message) {
            System.err.println(color + NAME + ": " + message + RESET);
        }

        static void warn(String message) {
            WARN.out(message);
        }

        static void stop(String message) {
            ERROR.out(message);
            System.exit(1);
        }
    }
}

interface Control {

    Path HOME = Path.of(System.getProperty("user.home"));
    String RELEASE_API = "https://api.github.com/repos/AdamBien/airails/releases/tags/skills";
    String BUNDLE_URL = "https://github.com/AdamBien/airails/releases/download/skills/airails-%s.zip";
    Pattern ASSET_NAME = Pattern.compile("\"name\"\\s*:\\s*\"airails-([^\"]+)\\.zip\"");
    HttpClient HTTP = HttpClient.newBuilder()
            .followRedirects(HttpClient.Redirect.ALWAYS)
            .connectTimeout(Duration.ofSeconds(20))
            .build();

    /// The per-agent zips (`airails-claude.zip`, …) unzip into `$HOME` and are not bundles.
    static List<String> releasedBundles() throws IOException, InterruptedException {
        var request = HttpRequest.newBuilder(URI.create(RELEASE_API)).header("Accept", "application/vnd.github+json").build();
        var response = HTTP.send(request, HttpResponse.BodyHandlers.ofString());
        if (response.statusCode() != HttpURLConnection.HTTP_OK) {
            throw new IOException("HTTP " + response.statusCode());
        }
        var bundles = ASSET_NAME.matcher(response.body())
                .results()
                .map(match -> match.group(1))
                .filter(Control::isBundle)
                .sorted(Entity.SKILLS_FIRST)
                .toList();
        if (bundles.isEmpty()) {
            throw new IOException("no bundle assets found");
        }
        return bundles;
    }

    static boolean isBundle(String asset) {
        return !Entity.Agent.IDS.contains(asset);
    }

    static List<String> detectedAgents() {
        return Entity.Agent.ALL.stream().filter(Control::isDetected).map(Entity.Agent::id).toList();
    }

    static boolean isDetected(Entity.Agent agent) {
        return Files.isDirectory(HOME.resolve(agent.marker()));
    }

    static List<Entity.Bundle> download(List<String> names, Path work) throws IOException, InterruptedException {
        var bundles = new ArrayList<Entity.Bundle>();
        for (var name : names) {
            bundles.add(download(name, work));
        }
        return List.copyOf(bundles);
    }

    static Entity.Bundle download(String name, Path work) throws IOException, InterruptedException {
        var url = BUNDLE_URL.formatted(name);
        var zip = work.resolve("airails-%s.zip".formatted(name));
        var response = HTTP.send(HttpRequest.newBuilder(URI.create(url)).build(), HttpResponse.BodyHandlers.ofFile(zip));
        if (response.statusCode() != HttpURLConnection.HTTP_OK) {
            throw new IOException("download failed (HTTP %d) for %s".formatted(response.statusCode(), url));
        }
        return new Entity.Bundle(name, zip, skillsIn(zip));
    }

    static SortedSet<String> skillsIn(Path zip) throws IOException {
        var skills = new TreeSet<String>();
        try (var in = new ZipInputStream(Files.newInputStream(zip))) {
            for (var entry = in.getNextEntry(); entry != null; entry = in.getNextEntry()) {
                var stripped = stripPrefix(entry.getName());
                if (!stripped.isEmpty()) {
                    skills.add(skillOf(stripped));
                }
            }
        }
        return skills;
    }

    /// Distinct skills written, bundles overlapping by design.
    static int installInto(List<Entity.Bundle> bundles, Path directory) throws IOException {
        var installed = new TreeSet<String>();
        for (var bundle : bundles) {
            installed.addAll(unzipInto(bundle.zip(), directory));
        }
        return installed.size();
    }

    /// Drops the leading `skills/` so `target/<skill>/SKILL.md` results; rejects
    /// entries resolving outside `target` (Zip-Slip); overwrites a skill of the
    /// same name, the release being the source of truth; re-grants `+x` to
    /// shebang files, which `ZipInputStream` cannot carry.
    static SortedSet<String> unzipInto(Path zip, Path target) throws IOException {
        var base = target.toAbsolutePath().normalize();
        var written = new TreeSet<String>();
        try (var in = new ZipInputStream(Files.newInputStream(zip))) {
            for (var entry = in.getNextEntry(); entry != null; entry = in.getNextEntry()) {
                var stripped = stripPrefix(entry.getName());
                if (stripped.isEmpty()) {
                    continue;
                }
                var resolved = base.resolve(stripped).normalize();
                if (!resolved.startsWith(base)) {
                    throw new IOException("blocked path traversal: " + entry.getName());
                }
                written.add(skillOf(stripped));
                if (entry.isDirectory()) {
                    Files.createDirectories(resolved);
                    continue;
                }
                Files.createDirectories(resolved.getParent());
                Files.copy(in, resolved, StandardCopyOption.REPLACE_EXISTING);
                if (startsWithShebang(resolved)) {
                    resolved.toFile().setExecutable(true, false);
                }
            }
        }
        return written;
    }

    static String stripPrefix(String entryName) {
        var slash = entryName.indexOf('/');
        return slash < 0 ? "" : entryName.substring(slash + 1);
    }

    static String skillOf(String strippedEntry) {
        return strippedEntry.split("/", 2)[0];
    }

    static boolean startsWithShebang(Path file) throws IOException {
        try (var in = Files.newInputStream(file)) {
            return in.read() == '#' && in.read() == '!';
        }
    }

    static void deleteRecursively(Path dir) throws IOException {
        try (var paths = Files.walk(dir)) {
            for (var path : (Iterable<Path>) paths.sorted(Comparator.reverseOrder())::iterator) {
                Files.delete(path);
            }
        }
    }
}

interface Entity {

    Map<String, String> HINTS = Map.of(
            "skills", "every skill",
            "java-server", "MicroProfile / Jakarta EE servers",
            "java-cli", "Java CLI applications and scripts",
            "web", "static sites, sprinkles, web components",
            "migrations", "legacy system migration",
            "fullstack", "spec-driven MicroProfile backend plus web-components frontend",
            "sbce", "spec-driven BCE, add-on to a stack bundle",
            "documentation", "diagrams and README, add-on to a stack bundle"
    );

    /// For when the release API is unreachable; downloads still go against the release.
    List<String> FALLBACK_BUNDLES = List.of("skills", "java-server", "java-cli", "web", "migrations", "fullstack", "sbce", "documentation");

    Comparator<String> SKILLS_FIRST = Comparator.comparing((String bundle) -> !bundle.equals("skills"))
            .thenComparing(Comparator.naturalOrder());

    static String hint(String bundle) {
        return HINTS.getOrDefault(bundle, "");
    }

    /// A menu answer token: a 1-based number or an option name.
    static Optional<String> pick(List<String> options, String token) {
        if (isIndex(token, options.size())) {
            return Optional.of(options.get(Integer.parseInt(token) - 1));
        }
        return options.contains(token) ? Optional.of(token) : Optional.empty();
    }

    static boolean isIndex(String token, int size) {
        return token.matches("\\d{1,3}") && Integer.parseInt(token) >= 1 && Integer.parseInt(token) <= size;
    }

    enum Arg {

        HELP("-help", "", "show this help"),
        VERSION("-version", "", "show version"),
        LIST("-list", "", "list released bundles"),
        GLOBAL("-global", "", "install globally, into the home directory"),
        PROJECT("-project", "<root>", "install into a project, checked in with it"),
        AGENTS("-agents", "<ids>", "comma-separated: " + String.join(",", Agent.IDS)),
        BUNDLES("-bundles", "<names>", "comma-separated released bundles, see -list"),
        YES("-yes", "", "proceed without the final confirmation");

        String option;
        String value;
        String description;

        Arg(String option, String value, String description) {
            this.option = option;
            this.value = value;
            this.description = description;
        }

        boolean matches(String argument) {
            return option.equals(argument) || argument.startsWith(option + ":");
        }

        static Arg from(String argument) {
            return Stream.of(values()).filter(arg -> arg.matches(argument)).findFirst().orElse(null);
        }

        static String usage() {
            return Stream.of(values()).map(Arg::line).collect(Collectors.joining("\n"));
        }

        String line() {
            return "  %-18s %s".formatted((option + " " + value).strip(), description);
        }
    }

    /// Parsed options; empty lists and a null project mean "ask".
    record Invocation(boolean list, boolean global, Path project, List<String> agents, List<String> bundles, boolean yes) {}

    /// Project directories are not the home layout moved down a level: Copilot
    /// reads `.github/skills` in a repository, Codex and Goose share `.agents/skills`.
    record Agent(String id, String marker, String globalSkills, String projectSkills) {

        static final List<Agent> ALL = List.of(
                new Agent("claude", ".claude", ".claude/skills", ".claude/skills"),
                new Agent("vibe", ".vibe", ".vibe/skills", ".vibe/skills"),
                new Agent("kiro", ".kiro", ".kiro/skills", ".kiro/skills"),
                new Agent("copilot", ".copilot", ".copilot/skills", ".github/skills"),
                new Agent("codex", ".codex", ".agents/skills", ".agents/skills"),
                new Agent("goose", ".config/goose", ".config/goose/skills", ".agents/skills")
        );
        static final List<String> IDS = ALL.stream().map(Agent::id).toList();

        static Agent of(String id) {
            return ALL.stream().filter(agent -> agent.id.equals(id)).findFirst().orElseThrow();
        }
    }

    sealed interface Scope permits Global, Project {

        Path directoryFor(Agent agent);

        String label();

        /// Agents sharing a directory collapse into one entry, in agent order.
        default Map<Path, List<String>> directories(List<Agent> agents) {
            return agents.stream().collect(Collectors.groupingBy(
                    this::directoryFor, LinkedHashMap::new, Collectors.mapping(Agent::id, Collectors.toList())));
        }
    }

    record Global(Path home) implements Scope {

        public Path directoryFor(Agent agent) {
            return home.resolve(agent.globalSkills());
        }

        public String label() {
            return "global";
        }
    }

    record Project(Path root) implements Scope {

        public Path directoryFor(Agent agent) {
            return root.resolve(agent.projectSkills());
        }

        public String label() {
            return "project " + root;
        }
    }

    record Bundle(String name, Path zip, SortedSet<String> skills) {

        String describe() {
            return "  %s: %s".formatted(name, String.join(", ", skills));
        }
    }
}

void main(String... args) throws Exception {
    Boundary.installBundles(List.of(args));
}
