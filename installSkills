#!/usr/bin/env -S java --source 25

/// Installs airails.dev skills from the cloned (or downloaded) repository into
/// the skill directories of supported AI agents. Run from the repository root:
/// `./installSkills` for the agents' home directories (global scope), or
/// `./installSkills -p <project-root>` for the agents' project directories
/// (project scope), which a repository checks in so the skills apply to
/// everyone working on it. Based on https://github.com/adambien/zeeds.
String name = MethodHandles.lookup().lookupClass().getName();
String version = "2026-11-06.1";

/// A skills directory relative to a scope root, and the agents reading it.
record Target(String agents, String directory) {}

/// Where the skills land: a root (`$HOME` or a project) and its targets.
record Scope(String label, Path root, List<Target> targets) {
    List<Path> directories() {
        return targets.stream().map(t -> root.resolve(t.directory())).toList();
    }

    String agentsOf(Path directory) {
        return targets.stream()
                .filter(t -> root.resolve(t.directory()).equals(directory))
                .map(Target::agents)
                .findFirst()
                .orElse("");
    }
}

/// Home-relative skills directories, one per agent.
Scope global() {
    return new Scope("global", Path.of(System.getProperty("user.home")), List.of(
            new Target("claude", ".claude/skills"),
            new Target("vibe", ".vibe/skills"),
            new Target("kiro", ".kiro/skills"),
            new Target("copilot", ".copilot/skills"),
            new Target("codex", ".agents/skills"),
            new Target("goose", ".config/goose/skills")
    ));
}

/// Project-relative skills directories. Not the home layout moved down a
/// level: Copilot reads `.github/skills` in a repository, and Codex and Goose
/// both read `.agents/skills`, so that directory is offered once for both.
Scope project(Path root) {
    return new Scope("project", root, List.of(
            new Target("claude", ".claude/skills"),
            new Target("vibe", ".vibe/skills"),
            new Target("kiro", ".kiro/skills"),
            new Target("copilot", ".github/skills"),
            new Target("codex, goose", ".agents/skills")
    ));
}

void main(String... args) throws Exception {
    IO.println(name + " " + version);
    var scope = global();
    var rest = new ArrayList<String>();
    for (var i = 0; i < args.length; i++) {
        if (args[i].equals("-p")) {
            if (++i == args.length) {
                fail("-p requires a project root");
            }
            scope = project(projectRoot(args[i]));
        } else {
            rest.add(args[i]);
        }
    }
    switch (rest.isEmpty() ? "" : rest.getFirst()) {
        case "-version" -> {}
        case "-h" -> help();
        case "-l" -> listSkills(scope);
        case "-d" -> deleteSkill(scope, rest.size() > 1 ? rest.get(1) : null);
        default -> installSkills(scope);
    }
}

void help() {
    IO.println("""
            Usage: %1$s                           install all skills into the agents' home directories
                   %1$s -p <project-root>         install all skills into the agents' directories of a project
                   %1$s -l [-p <project-root>]    list available and installed skills
                   %1$s -d <name> [-p <project-root>]  delete a skill by folder name
                   %1$s -h                        show this help
                   %1$s -version                  show version
            """.formatted(name));
}

Path projectRoot(String arg) {
    var root = Path.of(arg).toAbsolutePath().normalize();
    if (!Files.isDirectory(root)) {
        fail("project root %s is not a directory".formatted(root));
    }
    return root;
}

void installSkills(Scope scope) throws IOException {
    var source = Path.of("").toAbsolutePath();
    var skills = findSkillDirs(source);
    var skillNames = skills.stream().map(this::skillName).collect(Collectors.joining(", "));
    IO.println("%s: %d skill(s) in %s: %s".formatted(name, skills.size(), source, skillNames));
    IO.println("%s: %s scope, root %s".formatted(name, scope.label(), scope.root()));
    var console = requireConsole();
    for (var target : scope.directories()) {
        if (!isYes(console.readLine("Install to %s (%s)? [y/N] ", target, scope.agentsOf(target)))) {
            IO.println("  skipped");
            continue;
        }
        for (var skill : skills) {
            var dest = target.resolve(skillName(skill));
            copySkill(skill, dest);
            IO.println("  %s -> %s".formatted(skillName(skill), dest));
        }
    }
    IO.println(name + ": done");
}

void listSkills(Scope scope) throws IOException {
    IO.println(name + ": available");
    for (var skill : findSkillDirs(Path.of("").toAbsolutePath())) {
        IO.println("  " + skillName(skill));
    }
    IO.println("%s: installed (%s scope, root %s)".formatted(name, scope.label(), scope.root()));
    for (var target : scope.directories()) {
        var skills = findSkillDirs(target);
        if (skills.isEmpty()) {
            continue;
        }
        IO.println("  %s (%s)".formatted(target, scope.agentsOf(target)));
        for (var skill : skills) {
            IO.println("    " + skillName(skill));
        }
    }
}

void deleteSkill(Scope scope, String skill) throws IOException {
    if (skill == null) {
        fail("-d requires a skill name");
    }
    var console = requireConsole();
    var found = false;
    for (var target : scope.directories()) {
        var dir = target.resolve(skill);
        if (!Files.exists(dir)) {
            continue;
        }
        found = true;
        if (isYes(console.readLine("  delete %s? [y/N] ", dir))) {
            deleteRecursively(dir);
            IO.println("  deleted");
        } else {
            IO.println("  skipped");
        }
    }
    if (!found) {
        System.err.println("%s: skill '%s' not found in any %s target".formatted(name, skill, scope.label()));
    }
}

/// Skill directories under `root` — the parent of every `SKILL.md`, skipping
/// dot-directories *below* `root`. Visibility is judged on the relativized path
/// so an agent target whose own prefix carries a dot (`~/.claude/skills`) is not
/// excluded wholesale, only its `.`-prefixed children are.
List<Path> findSkillDirs(Path root) throws IOException {
    if (!Files.exists(root)) {
        return List.of();
    }
    try (var paths = Files.walk(root)) {
        return paths
                .filter(this::isSkillFile)
                .map(Path::getParent)
                .filter(dir -> isVisible(root, dir))
                .sorted()
                .toList();
    }
}

/// Copies the whole skill directory — `SKILL.md` plus any `references/`,
/// `assets/`, or `POWER.md` siblings the skill needs — minus repository noise
/// (`README.md`, dotfiles, `.claude/`). Copying only `SKILL.md` would strip the
/// bundled resources reference-backed skills (sbce, drawio, python-to-java, …)
/// load at runtime.
void copySkill(Path skillDir, Path destDir) throws IOException {
    try (var paths = Files.walk(skillDir)) {
        for (var source : (Iterable<Path>) paths::iterator) {
            var relative = skillDir.relativize(source);
            if (isNoise(relative)) {
                continue;
            }
            var resolved = destDir.resolve(relative);
            if (Files.isDirectory(source)) {
                Files.createDirectories(resolved);
            } else {
                Files.createDirectories(resolved.getParent());
                Files.copy(source, resolved, StandardCopyOption.REPLACE_EXISTING);
            }
        }
    }
}

void deleteRecursively(Path dir) throws IOException {
    try (var paths = Files.walk(dir)) {
        for (var path : (Iterable<Path>) paths.sorted(Comparator.reverseOrder())::iterator) {
            Files.delete(path);
        }
    }
}

Console requireConsole() {
    var console = System.console();
    if (console == null) {
        fail("interactive terminal required — run ./installSkills directly, not piped");
    }
    return console;
}

void fail(String message) {
    System.err.println("%s: %s".formatted(name, message));
    System.exit(1);
}

boolean isNoise(Path relative) {
    for (var segment : relative) {
        var part = segment.toString();
        if (part.startsWith(".") || part.equals("README.md")) {
            return true;
        }
    }
    return false;
}

boolean isVisible(Path root, Path path) {
    return !root.relativize(path).toString().contains(File.separator + ".");
}

boolean isSkillFile(Path path) {
    return path.getFileName().toString().equals("SKILL.md");
}

boolean isYes(String answer) {
    return answer != null && answer.strip().equalsIgnoreCase("y");
}

String skillName(Path skillDir) {
    return skillDir.getFileName().toString();
}
