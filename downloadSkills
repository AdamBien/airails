#!/usr/bin/env -S java --source 25

import module java.base;
import module java.net.http;

String name = MethodHandles.lookup().lookupClass().getName();
String version = "2026-11-06.1";

/// Git-free counterpart to `git clone`: fetches the airails.dev repository into
/// `./airails` so the interactive `./installSkills` can take over from there.
/// Mirrors the one-liner ergonomics of zsmith's `zsinstall`, but because airails
/// ships skill *directories* (not a single released JAR) it unpacks the whole
/// repository archive instead of a lone artifact.
///
/// ```
/// curl -fsSL https://raw.githubusercontent.com/AdamBien/airails/main/downloadSkills | java --source 25 /dev/stdin
/// cd airails
/// ./installSkills
/// ```
///
/// Given bundle names, it skips the repository and installs the agent-neutral
/// bundle zips of the rolling `skills` release directly into a skills
/// directory — `~/.claude/skills` by default, or the one passed with `-d`,
/// e.g. `.claude/skills` for a project-local install. The `skills/` prefix
/// the bundles carry is stripped, so the destination is the skills directory
/// itself, as listed per agent in AGENTS.md:
///
/// ```
/// curl -fsSL https://raw.githubusercontent.com/AdamBien/airails/main/downloadSkills | java --source 25 /dev/stdin web sbce -d .claude/skills
/// ```
///
/// Install logic for the full repository lives in `installSkills` alone — the
/// no-argument mode only obtains the sources, leaving the prompts, listing,
/// and deletion to the single installer. Bundles are pre-selected subsets, so
/// there is nothing left to prompt for.
String archiveUrl = "https://codeload.github.com/AdamBien/airails/zip/refs/heads/main";
String bundleUrl = "https://github.com/AdamBien/airails/releases/download/skills/airails-%s.zip";
Path output = Path.of("airails");
Path defaultSkillsDirectory = Path.of(System.getProperty("user.home"), ".claude", "skills");

/// Archives of the `skills` release whose entries live under a plain `skills/`
/// prefix: `skills` holds every skill, the rest are the per-stack bundles and
/// add-ons of `bundles()` in `zipSkills` — when a bundle is added there, add it
/// here too. The per-agent zips are excluded; they unzip into `$HOME`.
List<String> bundles() {
    return List.of("skills", "sbce", "documentation", "java-server", "java-cli", "web", "migrations");
}

void main(String... args) throws Exception {
    IO.println("%s %s".formatted(name, version));
    var requested = new ArrayList<String>();
    Path skillsDirectory = null;
    for (var i = 0; i < args.length; i++) {
        switch (args[i]) {
            case "-h" -> {
                help();
                return;
            }
            case "-d" -> {
                if (++i == args.length) {
                    fail("-d requires a skills directory");
                }
                skillsDirectory = Path.of(args[i]);
            }
            default -> requested.add(args[i]);
        }
    }
    if (requested.isEmpty()) {
        if (skillsDirectory != null) {
            fail("-d applies to bundles only; name at least one of: " + String.join(", ", bundles()));
        }
        downloadRepository();
    } else {
        downloadBundles(requested, skillsDirectory == null ? defaultSkillsDirectory : skillsDirectory);
    }
}

void help() {
    IO.println("""
               usage:
                 %1$s                         fetch the repository into ./airails, then run ./installSkills there
                 %1$s <bundle>... [-d <dir>]  install bundle(s) from the skills release into the skills directory <dir>
                 %1$s -h                      show this help
               <dir> defaults to ~/.claude/skills; pass -d .claude/skills for a project-local install
               bundles: %2$s""".formatted(name, String.join(", ", bundles())));
}

void downloadRepository() throws Exception {
    if (Files.exists(output)) {
        fail("%s already exists — remove it and retry".formatted(output.toAbsolutePath()));
    }
    var work = Files.createTempDirectory(name + "-");
    try {
        var zip = download(archiveUrl, work.resolve("airails.zip"));
        unzipInto(zip, output);
        IO.println("%s: extracted to %s".formatted(name, output.toAbsolutePath()));
        IO.println("%s: next — cd %s && ./installSkills".formatted(name, output));
    } finally {
        deleteRecursively(work);
    }
}

/// Validates every name before the first download, so a typo fails fast
/// instead of after half the bundles landed. Extracting overwrites a skill of
/// the same name — acceptable, the release is the source of truth — and
/// bundles overlap by design, so a shared skill is simply written twice.
void downloadBundles(List<String> requested, Path skillsDirectory) throws Exception {
    var unknown = requested.stream().filter(b -> !bundles().contains(b)).toList();
    if (!unknown.isEmpty()) {
        fail("unknown bundle(s) %s — choose from: %s".formatted(unknown, String.join(", ", bundles())));
    }
    var work = Files.createTempDirectory(name + "-");
    try {
        for (var bundle : requested) {
            var zip = download(bundleUrl.formatted(bundle), work.resolve("airails-%s.zip".formatted(bundle)));
            var skills = unzipInto(zip, skillsDirectory);
            IO.println("%s: %s — %d skill(s) into %s".formatted(name, bundle, skills.size(), skillsDirectory.toAbsolutePath()));
            IO.println("  " + String.join(", ", skills));
        }
    } finally {
        deleteRecursively(work);
    }
}

/// Atomic-staged download: the destination either keeps its prior content or
/// becomes the complete archive, never a truncated stream. Exit-on-failure on
/// non-200 — a single-file script has no caller to unwind to.
Path download(String url, Path destination) throws Exception {
    IO.println("%s: fetching %s".formatted(name, url));
    var staging = Files.createTempFile(destination.getParent(), destination.getFileName() + "-", ".part");
    var client = HttpClient.newBuilder().followRedirects(HttpClient.Redirect.ALWAYS).build();
    var request = HttpRequest.newBuilder(URI.create(url)).build();
    var response = client.send(request, HttpResponse.BodyHandlers.ofFile(staging));
    if (response.statusCode() != HttpURLConnection.HTTP_OK) {
        Files.deleteIfExists(staging);
        fail("download failed (HTTP %d)".formatted(response.statusCode()));
    }
    Files.move(staging, destination, StandardCopyOption.REPLACE_EXISTING);
    return destination;
}

/// Unpacks an archive into `target`, stripping the single leading component
/// every entry is wrapped in — `airails-main/` in the GitHub repository
/// archive, `skills/` in a bundle — so `target` mirrors the wrapped content
/// rather than nesting it. Guards against Zip-Slip by rejecting any entry that
/// would resolve outside `target`. Returns the top-level names written: the
/// skill directories for a bundle.
///
/// `ZipInputStream` does not carry the Unix mode bits, so `installSkills` and
/// bundled executables such as `web-conventions/scripts/zws` would arrive
/// non-executable. Re-grants `+x` to every shebang file (`#!` first two
/// bytes) without hard-coding script names.
SortedSet<String> unzipInto(Path zip, Path target) throws IOException {
    var base = target.toAbsolutePath().normalize();
    var written = new TreeSet<String>();
    try (var in = new ZipInputStream(Files.newInputStream(zip))) {
        for (var entry = in.getNextEntry(); entry != null; entry = in.getNextEntry()) {
            var stripped = strip(entry.getName());
            if (stripped.isEmpty()) {
                continue;
            }
            var resolved = base.resolve(stripped).normalize();
            if (!resolved.startsWith(base)) {
                throw new IOException("blocked path traversal: " + entry.getName());
            }
            written.add(stripped.split("/", 2)[0]);
            if (entry.isDirectory()) {
                Files.createDirectories(resolved);
            } else {
                Files.createDirectories(resolved.getParent());
                Files.copy(in, resolved, StandardCopyOption.REPLACE_EXISTING);
                if (startsWithShebang(resolved)) {
                    resolved.toFile().setExecutable(true, false);
                }
            }
        }
    }
    return written;
}

/// Drops the first path segment of an archive entry; the wrapper directory
/// itself maps to the empty string.
String strip(String entryName) {
    var slash = entryName.indexOf('/');
    return slash < 0 ? "" : entryName.substring(slash + 1);
}

boolean startsWithShebang(Path file) throws IOException {
    try (var in = Files.newInputStream(file)) {
        return in.read() == '#' && in.read() == '!';
    }
}

void deleteRecursively(Path dir) throws IOException {
    if (!Files.exists(dir)) {
        return;
    }
    try (var paths = Files.walk(dir)) {
        paths.sorted(Comparator.reverseOrder()).forEach(p -> {
            try {
                Files.delete(p);
            } catch (IOException e) {
                throw new UncheckedIOException(e);
            }
        });
    }
}

void fail(String message) {
    System.err.println("%s: %s".formatted(name, message));
    System.exit(1);
}
